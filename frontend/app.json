{
  "expo": {
    "name": "Arovia",
    "slug": "arovia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arovia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.arovia.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Arovia uses the camera for health records and documents.",
        "NSLocationWhenInUseUsageDescription": "Arovia uses your location to find nearby hospitals and emergency care.",
        "NSPhotoLibraryUsageDescription": "Arovia uses your photo library to attach medical reports."
      }
    },
    "android": {
      "package": "com.arovia.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Arovia uses the camera for health records and profile photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Arovia uses your location to find nearby hospitals and emergency care."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Arovia uses contacts for emergency notifications."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2563EB",
          "sounds": []
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
